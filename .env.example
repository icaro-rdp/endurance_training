# ==============================================================================
# Endurance Training Knowledge Base - Environment Configuration (.env)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spotify API & Scraping Credentials
# ------------------------------------------------------------------------------
# Create a Spotify Developer App at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"

# Your Spotify 'sp_dc' cookie from open.spotify.com (Application > Storage > Cookies)
# Required to fetch time-synced spoken podcast transcripts.
SPOTIFY_SP_DC="your_spotify_sp_dc_cookie_here"

# ------------------------------------------------------------------------------
# 2. Microsoft Azure Translator API (Tier 1 Priority)
# ------------------------------------------------------------------------------
# Create a free "Translator" resource in Azure Portal (Free F0 pricing tier)
# https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation
AZURE_TRANSLATOR_KEY="your_azure_translator_key_here"
# Examples: westeurope, eastus, global
AZURE_TRANSLATOR_REGION="westeurope"

# ------------------------------------------------------------------------------
# 3. DeepL Translation API (Tier 2 Priority)
# ------------------------------------------------------------------------------
# Sign up at https://www.deepl.com/pro#developer (Free plan authentication keys end with ':fx')
DEEPL_API_KEY="your_deepl_api_key_here:fx"

# ------------------------------------------------------------------------------
# 4. Local Apple Silicon MLX GPU Settings (Tier 3 Fallback / 100% Offline)
# ------------------------------------------------------------------------------
# Hugging Face model repository formatted for Apple Silicon MLX
LOCAL_MLX_MODEL="mlx-community/Qwen2.5-7B-Instruct-4bit"
